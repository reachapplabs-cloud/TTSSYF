{
  "name": "ugram",
  "private": true,
  "version": "0.1.0",
  "description": "Ugram (YouGram) — connect your YouTube and Instagram accounts and collect everything you've saved in one organized place.",
  "workspaces": [
    "packages/server",
    "packages/web"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace=packages/server",
    "build:server": "npm run build --workspace=packages/server",
    "dev:web": "npm run dev --workspace=packages/web",
    "build:web": "npm run build --workspace=packages/web",
    "db:migrate": "npm run db:migrate --workspace=packages/server",
    "db:studio": "npm run db:studio --workspace=packages/server"
  },
  "engines": {
    "node": ">=18"
  }
}
