PORT=4000

# SQLite by default — good for local dev / small deployments.
# Point this at Postgres for production (see docs/SETUP.md).
DATABASE_URL="file:./dev.db"

# Any long random string — signs the server's own session JWTs.
JWT_SECRET=change-me-to-a-long-random-string

# From Google Cloud Console → APIs & Services → Credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Origin(s) allowed to call the API. The extension is allowed automatically
# by its chrome-extension:// origin; this covers the web dashboard.
CLIENT_ORIGIN=http://localhost:5173
